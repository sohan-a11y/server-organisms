# Copy to .env for Muse Spark via Meta Model API. Demo works without it (fallback patcher).
META_API_KEY=
META_MODEL=muse-spark
META_API_BASE=https://api.meta.ai/v1
# Private random token between host broker and protected app (REQUIRED).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# Never use the public demo default and never commit a real .env.
# docker compose fails loudly when BROKER_TOKEN is unset; victim/broker
# fail closed (403) when it is unset or equals the public demo default.
# Dashboard: open http://localhost:18000/?token=<same BROKER_TOKEN value>
BROKER_TOKEN=
